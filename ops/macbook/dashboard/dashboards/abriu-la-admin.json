    {
      "id": 25,
      "type": "timeseries",
      "title": "Editais novos por dia (30 dias)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "licita-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 79,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "licita-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "with since as (select date_trunc('day', now() at time zone 'America/Sao_Paulo') - interval '29 days' as day),\ncreated as (\n  select date_trunc('day', created_at at time zone 'America/Sao_Paulo') as day, count(*) as n from tenders\n  where created_at >= (select day from since) at time zone 'America/Sao_Paulo' group by 1),\npublished as (\n  select date_trunc('day', published_at at time zone 'America/Sao_Paulo') as day, count(*) as n from tenders\n  where published_at >= (select day from since) at time zone 'America/Sao_Paulo' group by 1)\nselect (d.day at time zone 'America/Sao_Paulo') as time,\n       coalesce(c.n, 0) as \"Entraram na base\", coalesce(p.n, 0) as \"Publicados no PNCP\"\nfrom generate_series(\n      date_trunc('day', now() at time zone 'America/Sao_Paulo') - interval '29 days',\n      date_trunc('day', now() at time zone 'America/Sao_Paulo'),\n      interval '1 day') as d(day)\nleft join created c on c.day = d.day\nleft join published p on p.day = d.day\norder by d.day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "Janela fixa dos últimos 30 dias (fuso de São Paulo); não depende do seletor de tempo."
    },
