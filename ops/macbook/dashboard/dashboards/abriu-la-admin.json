          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select count(*) as \"Em trial\"\nfrom users u left join subscriptions s on s.user_id = u.id\nwhere u.trial_ends_at > now()\n  and not coalesce(s.status = 'active' or (s.status = 'canceled' and s.current_period_end > now()), false)"
