          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select (d.day at time zone 'America/Sao_Paulo') as time,\n       (select count(*) from ai_ask_requests a\n         where a.cache_hit = false and date_trunc('day', a.created_at at time zone 'America/Sao_Paulo') = d.day) as \"Perguntas novas\",\n       (select count(*) from ai_ask_requests a\n         where a.cache_hit = true and date_trunc('day', a.created_at at time zone 'America/Sao_Paulo') = d.day) as \"Perguntas em cache\",\n       (select count(*) from tender_ai_sheets t\n         where t.generated_at is not null and date_trunc('day', t.generated_at at time zone 'America/Sao_Paulo') = d.day) as \"Fichas geradas\"\nfrom generate_series(\n      date_trunc('day', now() at time zone 'America/Sao_Paulo') - interval '29 days',\n      date_trunc('day', now() at time zone 'America/Sao_Paulo'),\n      interval '1 day') as d(day)\norder by d.day"
