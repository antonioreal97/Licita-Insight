    {
      "id": 27,
      "type": "table",
      "title": "Usuários recentes",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "licita-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 89,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "licita-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select u.name as \"Nome\", u.email as \"E-mail\", u.created_at as \"Criado em\",\n       (select max(se.last_seen_at) from sessions se where se.user_id = u.id) as \"Último acesso\",\n       u.trial_ends_at as \"Trial até\",\n       coalesce(s.status, 'sem assinatura') as \"Assinatura\",\n       case\n         when s.status = 'active' then 'Pagante'\n         when s.status = 'canceled' and s.current_period_end > now() then 'Pago até o fim do período'\n         when u.trial_ends_at > now() then 'Em trial'\n         else 'Sem acesso'\n       end as \"Situação\"\nfrom users u left join subscriptions s on s.user_id = u.id\norder by u.created_at desc\nlimit 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
