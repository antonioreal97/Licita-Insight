          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select\n  count(distinct user_id) filter (where last_seen_at > now() - interval '24 hours') as \"24 h\",\n  count(distinct user_id) filter (where last_seen_at > now() - interval '7 days') as \"7 dias\",\n  count(distinct user_id) filter (where last_seen_at > now() - interval '30 days') as \"30 dias\"\nfrom sessions"
