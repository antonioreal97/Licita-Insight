          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select distinct on (source) source as \"Fonte\", status as \"Status\", started_at as \"Início\",\n       finished_at as \"Fim\", heartbeat_at as \"Último sinal\", upserted as \"Gravados\",\n       left(coalesce(error, ''), 160) as \"Erro\"\nfrom ingest_runs order by source, started_at desc"
