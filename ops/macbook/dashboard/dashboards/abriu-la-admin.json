      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "licita-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select (d.day at time zone 'America/Sao_Paulo') as time,\n       coalesce(sum(l.cost_usd) filter (where l.feature = 'title'), 0) as \"Títulos\",\n       coalesce(sum(l.cost_usd) filter (where l.feature = 'ask_summary'), 0) as \"Resumo de perguntas\",\n       coalesce(sum(l.cost_usd) filter (where l.feature = 'sheet_summary'), 0) as \"Resumo de fichas\"\nfrom generate_series(\n      date_trunc('day', now() at time zone 'America/Sao_Paulo') - interval '29 days',\n      date_trunc('day', now() at time zone 'America/Sao_Paulo'),\n      interval '1 day') as d(day)\nleft join ai_usage_ledger l\n  on l.feature in ('title', 'ask_summary', 'sheet_summary')\n and date_trunc('day', l.occurred_at at time zone 'America/Sao_Paulo') = d.day\ngroup by d.day order by d.day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
