    {
      "id": 18,
      "type": "timeseries",
      "title": "Custo OpenAI por dia (US$, 30 dias)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "licita-pg"
      },
      "gridPos": {
        "x": 12,
