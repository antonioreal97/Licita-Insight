            "uid": "licita-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select coalesce(round(100.0 * count(*) filter (where s.status = 'active') / nullif(count(*), 0), 1), 0) as \"Conversão (%)\"\nfrom users u left join subscriptions s on s.user_id = u.id\nwhere u.trial_ends_at is not null"
