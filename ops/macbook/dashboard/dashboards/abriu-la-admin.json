    {
      "id": 5,
      "type": "timeseries",
      "title": "Novos usuários por dia (30 dias)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "licita-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "licita-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select (d.day at time zone 'America/Sao_Paulo') as time, count(u.id) as \"Novos usuários\"\nfrom generate_series(\n      date_trunc('day', now() at time zone 'America/Sao_Paulo') - interval '29 days',\n      date_trunc('day', now() at time zone 'America/Sao_Paulo'),\n      interval '1 day') as d(day)\nleft join users u on date_trunc('day', u.created_at at time zone 'America/Sao_Paulo') = d.day\ngroup by d.day order by d.day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
