{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && node ./build.mjs && node --env-file-if-exists=../../.env --enable-source-maps ./dist/index.mjs",
    "dev:worker": "export NODE_ENV=development APP_ROLE=worker && node ./build.mjs && node --env-file-if-exists=../../.env --enable-source-maps ./dist/index.mjs",
    "build": "node ./build.mjs",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps ./dist/index.mjs",
    "start:worker": "export APP_ROLE=worker && node --env-file-if-exists=../../.env --enable-source-maps ./dist/index.mjs",
    "collect:pncp": "node --env-file-if-exists=../../.env --import tsx src/ingest/collect-pncp.ts",
    "collect:opportunities": "node --env-file-if-exists=../../.env --import tsx src/ingest/collect-opportunities.ts",
    "calibrate:jev": "node --env-file-if-exists=../../.env --import tsx scripts/calibrate-jev.ts",
    "calibrate:company-fit": "node --env-file-if-exists=../../.env --import tsx scripts/calibrate-company-fit.ts",
    "calibrate:tender-sheet": "node --env-file-if-exists=../../.env --import tsx scripts/calibrate-tender-sheet.ts",
    "calibrate:qualification-checklist": "node --env-file-if-exists=../../.env --import tsx scripts/calibrate-qualification-checklist.ts",
    "scale:seed": "node --env-file-if-exists=../../.env --import tsx scripts/scale-seed.ts",
    "scale:load": "node --env-file-if-exists=../../.env --import tsx scripts/scale-load.ts",
    "scale:drop": "node --env-file-if-exists=../../.env --import tsx scripts/scale-drop.ts",
    "report:ai-cost": "node --env-file-if-exists=../../.env --import tsx scripts/report-ai-cost.ts",
    "report:fit-gate": "node --env-file-if-exists=../../.env --import tsx scripts/report-fit-gate.ts",
    "report:retention": "node --env-file-if-exists=../../.env --import tsx scripts/report-retention.ts",
    "test:dist-pdf": "node ./build.mjs && node scripts/verify-dist-pdf.mjs",
    "test:dist-sheet": "node ./build.mjs && node scripts/verify-dist-sheet.mjs",
    "test": "tsx --test src/**/*.test.ts && pnpm run test:dist-sheet",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "compression": "^1.8.1",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "helmet": "^8.1.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
