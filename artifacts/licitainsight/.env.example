# Adapter: "mock" (default, in-memory fixtures) or "http" (real backend).
VITE_API_MODE=mock
# Base URL for the HTTP adapter. Local API: PORT=3001 pnpm --config.verify-deps-before-run=false --dir artifacts/api-server run dev
VITE_API_BASE_URL=http://localhost:3001/api
# Simulated latency for the mock adapter, in ms.
VITE_MOCK_LATENCY_MS=350
