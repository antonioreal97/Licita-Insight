# Copy to .env.oracle on the A1 host, chmod 600, and replace every "change-me".
ORACLE_PLATFORM=linux/arm64
ORACLE_ENV_FILE=.env.oracle
ORACLE_TAILSCALE_IP=100.64.0.10
ORACLE_DATA_DIR=/srv/pardal/postgres
IMAGE_TAG=oracle-stage-0

POSTGRES_DB=licitainsight
POSTGRES_USER=licitainsight
POSTGRES_PASSWORD=change-me-long-random-password
DATABASE_URL=postgresql://licitainsight:change-me-long-random-password@db:5432/licitainsight

PUBLIC_HOSTNAME=api.example.com
PUBLIC_APP_ORIGIN=https://app.example.com
TLS_CERT_DIR=/srv/pardal/tls
SESSION_SECRET=change-me-at-least-32-random-bytes
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
ASAAS_API_KEY=change-me
ASAAS_API_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=change-me
BILLING_MONTHLY_BRL=change-me

# Optional integrations. Leave unset if the feature is disabled.
RESEND_API_KEY=
EMAIL_FROM=
OPENAI_API_KEY=

# The A1 runs API plus light jobs. Heavy jobs stay on the local server.
APP_ROLE=api
WORKER_JOBS=light
PNCP_DAILY_COLLECT=false
TRANSPARENCY_DAILY_COLLECT=false
CULTURE_DAILY_COLLECT=false
FUNDING_DAILY_COLLECT=false
CULTURE_FEDERAL_DAILY_COLLECT=false
INTERNATIONAL_DAILY_COLLECT=false
CATEGORY_DAILY_CLASSIFY=false
