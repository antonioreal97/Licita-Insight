# Copie este modelo para .env na raiz do clone. Nunca versione o .env.
# Use senha hexadecimal para manter DATABASE_URL valida sem URL-encoding.
MAC_DB_PASSWORD=
SESSION_SECRET=
OPENAI_API_KEY=

# Credenciais do cliente OAuth que aceita http://localhost:24252/api/v1/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI trata somente editais novos ou com titulo oficial alterado.
OPENAI_MODEL=gpt-4o-mini
TITLE_OPENAI_DAILY_LIMIT=500
AI_DAILY_BUDGET_USD=10

# Ligue estas coletas apenas depois de restaurar e validar o banco.
PNCP_DAILY_COLLECT=false
TRANSPARENCY_DAILY_COLLECT=false
CULTURE_DAILY_COLLECT=false

# Se o ngrok ja roda no host, use sua URL HTTPS atual como origem da app.
# Atualize a URL e reinicie o app sempre que o tunnel mudar.
# PUBLIC_APP_ORIGIN=https://exemplo.ngrok-free.app

# Proxy local. Comece em log, configure o mesmo segredo na Vercel e depois troque para enforce.
ORIGIN_MODE=log
# ORIGIN_SHARED_SECRET=gere-com-openssl-rand-hex-32

# Opcional: para transferir o tunnel para compose.macbook.ngrok.yml,
# use a URL estavel atribuida a conta ngrok; nao inclua barra final.
NGROK_PUBLIC_URL=
NGROK_AUTHTOKEN=

# O checkout nao funciona sem acesso externo ao webhook do Asaas.
# ASAAS_API_KEY=
# ASAAS_API_BASE_URL=https://api.asaas.com/v3
# ASAAS_WEBHOOK_TOKEN=
# BILLING_MONTHLY_BRL=49.90
