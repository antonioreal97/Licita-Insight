DATABASE_URL=postgres://licita:licita@localhost:5432/licita
PORT=3001
NODE_ENV=development

# Jornadas adaptativas (lista separada por vírgulas: procurement,funding,study,research,culture).
# Ausente/vazia por padrão: nenhuma jornada nova é ativada e a interface atual permanece igual.
# FEATURE_JOURNEYS=

# PostgreSQL / pool. DB_STATEMENT_TIMEOUT_MS deve ser menor que REQUEST_TIMEOUT_MS.
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=2000
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_APPLICATION_NAME=licitai-api

# Proteção HTTP. TRUST_PROXY aceita false, true, número de saltos ou valor aceito pelo Express.
# TRUST_PROXY=false
# RATE_LIMIT_ANON_PER_MINUTE=60
# RATE_LIMIT_USER_PER_MINUTE=240
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_INGEST_PER_MINUTE=3
# RATE_LIMIT_AI_PER_MINUTE=60             # ask, ask-status, sheet, fit
# RATE_LIMIT_WRITE_PER_MINUTE=60          # other authenticated writes (/v1/me/*, logout)
# RATE_LIMIT_BILLING_PER_MINUTE=5         # checkout/cancel (call Asaas)
# RATE_LIMIT_PRIVACY_PER_HOUR=5           # data export + account deletion
# RATE_LIMIT_PUBLIC_WRITE_PER_MINUTE=10   # unsubscribe and other writes without a session, per IP
# RATE_LIMIT_MAX_ENTRIES=100000           # cap on keys in the in-memory rate limit store
# RATE_LIMIT_PREAUTH_PER_MINUTE=600  # cap on session lookups per IP (a session cookie costs a DB read before limits apply)
# MAX_INFLIGHT_PER_ANON=10
# MAX_INFLIGHT_PER_USER=20
# MAX_INFLIGHT_GLOBAL=200
# REQUEST_TIMEOUT_MS=30000
# LONG_REQUEST_TIMEOUT_MS=120000
# REQUEST_BODY_LIMIT=256kb
# HTTP_HEADERS_TIMEOUT_MS=15000
# HTTP_REQUEST_TIMEOUT_MS=30000
# HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
# HTTP_MAX_REQUESTS_PER_SOCKET=1000
# HTTP_MAX_CONNECTIONS=1000
# SHUTDOWN_TIMEOUT_MS=15000

# Account API / Google OAuth
PUBLIC_APP_ORIGIN=http://localhost:24252
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
# GA4 é opcional e embutido no build do frontend. Configure somente em Production na Vercel;
# deixe ausente em desenvolvimento, testes e previews.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Habilita POST /api/v1/auth/dev-login somente fora de production.
AUTH_DEV_LOGIN=false
# GOOGLE_HTTP_TIMEOUT_MS=15000

# Coleta diária ao subir a API e às 06:00 (America/Sao_Paulo). false desliga.
# PNCP_DAILY_COLLECT=false
# PNCP_DAILY_HOUR=6
# PNCP_REFRESH_LIMIT=200
# Abre separadamente os disjuntores do refresh de compra, do enriquecimento e
# dos resultados da transparência após este número de falhas recuperáveis.
# PNCP_REFRESH_MAX_CONSECUTIVE_FAILURES=3
# CULTURE_DAILY_COLLECT=false
# Intervalo mínimo entre páginas e política de retry da coleta cultural.
# CULTURE_PAGE_DELAY_MS=1000
# CULTURE_HTTP_MAX_RETRIES=2
# CULTURE_RETRY_BASE_MS=1000
# Teto de páginas (50 chamadas cada) por instalação do Mapas Culturais.
# CULTURE_MAX_PAGES=20
# 1 = chamadas que encerram hoje ou depois. Valor maior relê chamadas encerradas há poucos dias.
# CULTURE_LOOKBACK_DAYS=1
# Vazio por padrão. Exceção TLS somente por host exato e fingerprint SHA-256 do certificado folha.
# CULTURE_TLS_PINNED_HOSTS=
# Coleta de FINEP/CNPq/CAPES. Desligada por padrão; quando ligada roda às 08:00.
# FUNDING_DAILY_COLLECT=false
# FUNDING_DAILY_HOUR=8
# FUNDING_PAGE_DELAY_MS=1000
# "Onde se inscrever": no fim das coletas de fomento, cultura federal, internacional e Mapas, lê a página
# e os documentos oficiais da chamada, sem IA, para achar o link de inscrição e o período. Exige a migração
# 0043. Até APPLICATION_READ_MAX_CALLS chamadas lidas por coleta, com APPLICATION_READ_DELAY_MS entre
# requisições; false desliga a leitura sem mudar as coletas.
# OPPORTUNITY_APPLICATION_READING=true
# APPLICATION_READ_MAX_CALLS=20
# APPLICATION_READ_DELAY_MS=1000
# Coleta das fontes federais de cultura: Transferegov.br (API e CSV de dados abertos), editais do MinC
# (incluindo chamadas da Lei Rouanet com inscrição pelo Salic) e da Funarte. Desligada por padrão; ligada,
# roda 1x por dia às 09:00 e nunca ao subir. A hora aceita 7 a 23: 00:00-05:30 é do job noturno e 06:00 do PNCP.
# Exige a migração 0040 aplicada. Manual: pnpm --filter @workspace/api-server run collect:culture-federal
# (CULTURE_FEDERAL_DRY_RUN=true só lê as fontes e imprime, sem gravar).
# CULTURE_FEDERAL_COLLECT=false
# CULTURE_FEDERAL_HOUR=9
# CULTURE_FEDERAL_PAGE_DELAY_MS=1000
# Coleta das fontes internacionais: avisos de aquisição do Banco Mundial e do BID e chamadas do Funding & Tenders
# da União Europeia, pelas APIs públicas. Desligada por padrão; ligada, roda 1x por dia às 10:00 e nunca ao subir.
# A hora aceita 7 a 23: 00:00-05:30 é do job noturno e 06:00 do PNCP. Exige a migração 0041 aplicada.
# Manual: pnpm --filter @workspace/api-server run collect:international
# (INTERNATIONAL_DRY_RUN=true só lê as fontes e imprime as contagens, sem gravar nem exigir DATABASE_URL).
# INTERNATIONAL_COLLECT=false
# INTERNATIONAL_HOUR=10
# INTERNATIONAL_SOURCES=worldbank,eu_ft,idb
# INTERNATIONAL_PAGE_DELAY_MS=1000
# INTERNATIONAL_MAX_PAGES=40
# Título em português por modelo local, nunca OpenAI. off (padrão) mostra o título original e o resumo em
# português feito por regras. ollama usa OLLAMA_BASE_URL e exige o modelo abaixo (não há padrão: o modelo ainda
# será medido no servidor); libretranslate usa qualquer serviço com a API do LibreTranslate (Marian/OPUS-MT,
# NLLB) em INTERNATIONAL_TITLE_TRANSLATION_URL. A tradução roda depois da coleta, em lote limitado, e nunca a
# bloqueia. Deixe off até a medição no servidor (docs/contracts/opportunities-v1.md, "Tradução do título").
# INTERNATIONAL_TITLE_TRANSLATION=off
# INTERNATIONAL_TITLE_TRANSLATION_MODEL=
# INTERNATIONAL_TITLE_TRANSLATION_URL=http://localhost:5000
# INTERNATIONAL_TITLE_TRANSLATION_LANGUAGES=en,fr
# INTERNATIONAL_TITLE_TRANSLATION_BATCH=100
# INTERNATIONAL_TITLE_TRANSLATION_TIMEOUT_MS=30000
# Habilita as rotas HTTP /api/v1/ingest/* para operação manual. Mínimo 32 caracteres.
# Sem este segredo válido, as rotas respondem 404; com segredo, use Authorization: Bearer <token>.
# INGEST_API_TOKEN=replace-with-at-least-32-random-characters
# No Compose, transparência roda ao subir e uma hora após PNCP_DAILY_HOUR. false desliga.
# TRANSPARENCY_DAILY_COLLECT=false
# TRANSPARENCY_FROM=2026-10-01
# TRANSPARENCY_TO=2026-10-05
# TRANSPARENCY_PAGE_SIZE=500
# TRANSPARENCY_RESULTS_LIMIT=200

# Plataforma de disputa dos editais antigos: ao subir e às 02:00 (America/Sao_Paulo), só enquanto houver
# edital com platform nulo, com lock distribuído no PostgreSQL. false desliga.
# PLATFORM_BACKFILL_DAILY=false
# PLATFORM_BACKFILL_BATCH_SIZE=2000

# Valor estimado fora da curva: revisão ao subir e às 01:00 (America/Sao_Paulo) dos editais a partir de
# R$ 100 milhões, com lock distribuído no PostgreSQL. false desliga.
# ESTIMATED_VALUE_REVIEW_DAILY=false
# ESTIMATED_VALUE_REVIEW_BATCH_SIZE=1000

# Expurgo LGPD diário às 03:00 (America/Sao_Paulo), com lock distribuído no PostgreSQL.
# PERSONAL_DATA_RETENTION_DAILY=false
# PERSONAL_DATA_RETENTION_HOUR=3
# SESSION_RETENTION_DAYS=30
# READ_NOTIFICATION_RETENTION_DAYS=180
# EMAIL_CONTENT_RETENTION_DAYS=180

# Assinatura mensal (Asaas). Sem estas variáveis o checkout responde erro e o restante do app segue.
# Sandbox: https://api-sandbox.asaas.com/v3 — produção: https://api.asaas.com/v3
# ASAAS_API_KEY=
# ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_HTTP_TIMEOUT_MS=15000
# Valor em reais, com ponto. Produção: 49.90 (decisão de 26 set 2026).
# BILLING_MONTHLY_BRL=49.90
# Reconciliação diária com o Asaas (corrige webhook perdido), só com o Asaas configurado.
# Hora em America/Sao_Paulo, de 7 a 23 (fora da janela noturna e da coleta das 06:00). false desliga.
# Manual: pnpm --filter @workspace/api-server run billing:reconcile [--dry-run]
# BILLING_RECONCILE_ENABLED=false
# BILLING_RECONCILE_HOUR=14
# BILLING_RECONCILE_MAX_PER_RUN=200
# BILLING_RECONCILE_PAUSE_MS=1000
# Libera rotas pagas para qualquer usuário autenticado somente fora de production.
BILLING_DEV_ENTITLED=false
# Token forte usado pelo owner para emitir cupons via POST /api/v1/billing/coupons.
# COUPON_ADMIN_TOKEN=

# IA Jev: perguntas ao edital e aderência do perfil.
# JEV_API_KEY=
# JEV_MODEL=jev-1.13.0
# JEV_TIMEOUT_MS=15000
# Redação opcional dos trechos selecionados pelo Jev. Sem chave, os resumos ficam desligados.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=15000
# Preço em USD por 1 milhão de tokens (gpt-4o-mini em 02/10/2026).
# OPENAI_INPUT_USD_PER_MTOK=0.15
# OPENAI_OUTPUT_USD_PER_MTOK=0.60
# Cota de aderência separada da cota de perguntas.
# AI_DAILY_FIT_LIMIT=1000
# Processos (com edital legível) que cada usuário consulta com IA por dia: pergunta ou ficha.
# AI_DAILY_TENDER_LIMIT=10
# AI_DAILY_SHEET_LIMIT=500
# AI_SHEET_EVIDENCE_THRESHOLD=0.5
# AI_SHEET_ANSWER_THRESHOLD=0.6
# AI_SHEET_CANDIDATE_LIMIT=6
# AI_QUALIFICATION_CANDIDATE_LIMIT=40
# Tempo total de download de cada documento (o PNCP chega a entregar ~50 KB/s).
# AI_DOCUMENT_TIMEOUT_MS=300000
# Máximo de tentativas por documento (5 min, 30 min, 2 h e depois 1x/dia).
# AI_DOCUMENT_RETRY_MAX_ATTEMPTS=6
# AI_FIT_EXCLUDED_THRESHOLD=0.65

# Títulos e categorias com o Ollama local (sem custo). Desligado, o título e a categoria de reserva
# ainda vêm das regras. No Docker, o padrão do compose é http://host.docker.internal:11434.
# TITLE_TEACHER_ENABLED=false
# CATEGORY_STUDENT_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TEACHER_MODEL=gemma4:12b
# OLLAMA_EMBED_MODEL=bge-m3
# OLLAMA_TEACHER_TIMEOUT_MS=300000
# OLLAMA_EMBED_TIMEOUT_MS=60000
# OLLAMA_KEEP_ALIVE=10m
# Aluno: k vizinhos e confiança mínima para exibir categoria.
# CATEGORY_STUDENT_K=7
# CATEGORY_STUDENT_MIN_CONFIDENCE=0.42
# Com o aluno ligado, a classificação roda no job noturno (America/Sao_Paulo), antes da coleta das
# 06:00. NIGHTLY_CATEGORY_ENABLED=false volta a classificar logo após cada coleta.
# NIGHTLY_CATEGORY_ENABLED=true
# NIGHTLY_CATEGORY_WINDOW_START=00:00
# NIGHTLY_CATEGORY_WINDOW_END=05:30
# Editais por rodada e textos por chamada ao Ollama; parte da janela reservada aos exemplos.
# NIGHTLY_CATEGORY_BATCH=64
# NIGHTLY_CATEGORY_EMBED_CHUNK=8
# NIGHTLY_CATEGORY_EXAMPLE_SHARE=0.4
# NIGHTLY_CATEGORY_HOLDOUT_SAMPLE=500
# Jev como professor dos editais em que o aluno tem confiança abaixo do limiar (usa JEV_API_KEY).
# JEV_TEACHER_ENABLED=true
# JEV_TEACHER_CONFIDENCE_THRESHOLD=0.6
# JEV_TEACHER_DAILY_LIMIT=1500
# JEV_TEACHER_MIN_CONFIDENCE=0.5
# JEV_TEACHER_CONCURRENCY=4
# Reescritas sob demanda pelo professor por dia (America/Sao_Paulo).
# TITLE_REWRITE_DAILY_LIMIT=2000
# Editais novos/alterados e o backfill contínuo vão para a OpenAI (usa OPENAI_API_KEY e OPENAI_MODEL).
# O teto diário é aplicado no consumo; excedentes permanecem na fila para os dias seguintes.
# Desligado (padrão e produção), o título fica com as regras e a categoria com o job noturno.
# TITLE_TEACHER_OPENAI_ENABLED=false
# TITLE_OPENAI_DAILY_LIMIT=5000
# Orçamento exclusivo do professor em janela móvel; zero desliga este disjuntor.
TITLE_OPENAI_BUDGET_USD=1
TITLE_OPENAI_BUDGET_DAYS=3
# Backfill pequeno, fora da hora de coleta das 06:00 (America/Sao_Paulo).
TITLE_BACKFILL_ENABLED=true
# TITLE_BACKFILL_BATCH_SIZE=50
# TITLE_BACKFILL_INTERVAL_MS=300000
# TITLE_RULES_BACKFILL_BATCH_SIZE=500
# AI_QUEUE_MAX_DEPTH_TITLE_REWRITE=2000

# Alertas por e-mail (Brevo ou Resend). EMAIL_PROVIDER aceita brevo|resend.
# Sem EMAIL_PROVIDER: Brevo tem prioridade quando sua chave existe; depois Resend.
# Sem chave/remetente, a entrega fica como skipped.
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-...
# BREVO_HTTP_TIMEOUT_MS=15000
# RESEND_API_KEY=re_...
# RESEND_HTTP_TIMEOUT_MS=15000
# MAIL_FROM=Pardal Digital <alertas@example.com>
# MAIL_REPLY_TO=suporte@example.com
# Segredo estável (mínimo 32 caracteres). Não rotacionar junto com SESSION_SECRET.
# Sem ele, links de descadastro usam SESSION_SECRET por compatibilidade.
# EMAIL_UNSUBSCRIBE_SECRET=replace-with-at-least-32-random-characters
# EMAIL_JOBS_ENABLED=true # false desliga só envios/retries de e-mail; notificações no app continuam
# Hora local em America/Sao_Paulo (0-23).
# EMAIL_DIGEST_HOUR=7
# Janela de agrupamento dos alertas críticos (1-60 minutos).
# EMAIL_IMMEDIATE_WINDOW_MINUTES=10
# Intervalo do job independente de buscas salvas (1-1440 minutos).
# SAVED_SEARCH_JOB_INTERVAL_MINUTES=15

# Coletas HTTP externas.
# PNCP_HTTP_TIMEOUT_MS=60000
# Limites curtos exclusivos da API de manutenção /api/pncp/v1. Respostas 429
# continuam usando a política longa de espera e tentativas do PNCP.
# PNCP_DETAIL_HTTP_TIMEOUT_MS=20000
# PNCP_DETAIL_MAX_ATTEMPTS=2
# MAPAS_HTTP_TIMEOUT_MS=30000
APP_ROLE=all
WORKER_HEALTH_PORT=
# Diretório do bundle SPA; deixe ausente no dev. Só é servido nos papéis api/all.
STATIC_DIR=
JEV_MAX_CONCURRENCY=16
JEV_BATCH_MAX_SHARE=0.5
JEV_RPM_LIMIT=900
JEV_RPM_LIMIT_API=300
JEV_RPM_LIMIT_WORKER=600
JEV_INTERACTIVE_RESERVE_RPM=300
JEV_BACKOFF_MS=30000
JEV_INTERACTIVE_QUEUE_TIMEOUT_MS=5000
AI_FIT_LEXICAL_GATE=shadow
# Fila durável de índice, ficha e aderência.
AI_JOB_POLL_MS=1000
AI_JOB_VISIBILITY_TIMEOUT_MS=300000
WORKER_INDEX_CONCURRENCY=2
WORKER_SHEET_CONCURRENCY=2
WORKER_FIT_CONCURRENCY=8
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_URL=http://ocr:8080
DOCUMENT_OCR_MAX_PAGES=40
DOCUMENT_OCR_PAGE_TIMEOUT_MS=30000
OCR_LOW_CONFIDENCE_THRESHOLD=35
AI_QUEUE_MAX_DEPTH_DOCUMENT_OCR=1000
AI_INDEX_ENQUEUE_PER_USER_PER_HOUR=60
AI_QUEUE_MAX_DEPTH_INDEX=1000
AI_QUEUE_MAX_DEPTH_SHEET=1000
AI_QUEUE_MAX_DEPTH_FIT=10000
AI_DAILY_BUDGET_USD=10
AI_DAILY_BUDGET_WARN_RATIO=0.8
# Porta interna exclusiva de métricas Prometheus; ausente desliga.
METRICS_PORT=
# Number of hours after first insertion that a PNCP tender is shown as new.
NEW_TENDER_WINDOW_HOURS=24
