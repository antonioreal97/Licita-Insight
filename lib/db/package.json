{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./pool-config": "./src/pool-config.ts"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
    "push": "drizzle-kit push --config ./drizzle.config.ts && node --import tsx scripts/apply-ai-ledger.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts && node --import tsx scripts/apply-ai-ledger.ts",
    "prepare-extensions": "node --env-file-if-exists=../../.env --import tsx scripts/prepare-extensions.ts",
    "verify:ai-push": "node --env-file-if-exists=../../.env --import tsx scripts/verify-ai-push.ts",
    "verify:ai-ledger": "node --env-file-if-exists=../../.env --import tsx scripts/verify-ai-ledger.ts",
    "verify:fit-gate": "node --env-file-if-exists=../../.env --import tsx scripts/verify-fit-gate.ts",
    "verify:search-index": "node --env-file-if-exists=../../.env --import tsx scripts/verify-search-index.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "catalog:"
  }
}
