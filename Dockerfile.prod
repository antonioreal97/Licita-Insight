ARG TARGETPLATFORM=linux/amd64
FROM --platform=${TARGETPLATFORM} node:24-bookworm-slim AS build

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.5.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.json tsconfig.base.json ./
COPY artifacts ./artifacts
COPY lib ./lib
COPY scripts ./scripts

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/api-server run build
RUN PORT=4173 BASE_PATH=/ VITE_API_BASE_URL=/api NODE_ENV=production \
    pnpm --filter @workspace/licitainsight run build

FROM --platform=${TARGETPLATFORM} node:24-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.5.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY artifacts/api-server/package.json ./artifacts/api-server/package.json
COPY lib/api-zod/package.json ./lib/api-zod/package.json
COPY lib/db/package.json ./lib/db/package.json

RUN pnpm install --prod --frozen-lockfile \
    --filter @workspace/api-server... \
    --filter @workspace/db...

COPY --from=build --chown=node:node /app/artifacts/api-server/dist ./artifacts/api-server/dist
COPY --from=build --chown=node:node /app/artifacts/api-server/scripts/verify-dist-pdf.mjs ./artifacts/api-server/scripts/verify-dist-pdf.mjs
COPY --from=build --chown=node:node /app/artifacts/licitainsight/dist/public ./artifacts/licitainsight/dist/public
COPY --chown=node:node lib/db/migrations ./lib/db/migrations
COPY --chown=node:node lib/db/scripts/migrate.mjs ./lib/db/scripts/migrate.mjs

USER node
EXPOSE 3001 3002

CMD ["node", "--enable-source-maps", "artifacts/api-server/dist/index.mjs"]
