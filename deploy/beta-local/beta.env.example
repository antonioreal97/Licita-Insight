# Copy to ~/.licitai-secrets/beta.env and chmod 600. Never commit the real file.
POSTGRES_USER=licitai_beta
POSTGRES_PASSWORD=generate-a-long-random-password
POSTGRES_DB=licitai_beta
DATABASE_URL=postgres://licitai_beta:URL_ENCODED_PASSWORD@db:5432/licitai_beta
PUBLIC_APP_ORIGIN=https://beta.example.com
SESSION_SECRET=generate-at-least-32-random-characters
GOOGLE_CLIENT_ID=oauth-client-id
GOOGLE_CLIENT_SECRET=oauth-client-secret
JEV_API_KEY=jev-key
OPENAI_API_KEY=openai-key
RESEND_API_KEY=resend-key
MAIL_FROM=Pardal Digital <alertas@beta.example.com>
# Optional in free beta: leave ASAAS_* unset; checkout/webhooks are unavailable,
# while public search and beta grants continue to work.
# Days of PNCP publications fetched on the first boot (empty database); afterwards the ingest_days
# calendar skips closed days. Code default is 30 (national). See docs/ops/beta-local.md, section 6.
PNCP_LOOKBACK_DAYS=14
